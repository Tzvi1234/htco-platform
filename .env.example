# Local settings for `just up`. Every variable the API and the worker read is listed here with a
# safe local value (tests/tools/test_env_example.py checks it). Never put real secrets in this file; deployed environments get them from their secret
# stores.
HTCO_ENVIRONMENT=local
HTCO_LOG_LEVEL=INFO
HTCO_HOST=127.0.0.1
HTCO_PORT=8000
# Error monitoring (optional): a Sentry DSN turns it on. Leave unset locally.
# HTCO_SENTRY_DSN=
# The build being run, attached to error reports (CI sets the git commit SHA).
# HTCO_RELEASE=
# Postgres for /readyz (and, from slice 2.2, the API). Optional locally; required in staging and
# production. The local Supabase database after `just db-start`:
# HTCO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The Supabase project whose sign-in service issues access tokens. With HTCO_DATABASE_URL it turns
# authentication on; required (HTTPS) in staging and production. The local stack:
# HTCO_SUPABASE_URL=http://127.0.0.1:54321
# Supabase secret key (sb_secret_...), used only to send invitations; never for database queries.
# Without it, POST /v1/organizations/{id}/invitations answers 503.
# HTCO_SUPABASE_SECRET_KEY=
# Where the one-time invitation link lands (the web app's accept-invitation page).
# HTCO_INVITE_REDIRECT_URL=http://localhost:5173/accept-invite
# Where the emailed password reset link lands (the web app's reset page). Without it,
# POST /v1/auth/password/forgot answers 503.
# HTCO_PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password
# Web sign-in (slice 3.5). The session key seals Supabase tokens at rest: `openssl rand -base64 32`.
# HTCO_SESSION_KEY=
# The project's publishable key (not secret) and the web app origins allowed to use the cookie.
# HTCO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# HTCO_WEB_ORIGINS=http://localhost:5173
# Etsy app credentials (slice 4.1): the keystring and shared secret, sent as `x-api-key`. Secrets,
# set together; not needed until Phase 4 connects a shop. Never put real values in this file.
# HTCO_ETSY_KEYSTRING=
# HTCO_ETSY_SHARED_SECRET=
# Requests left today below which routine Etsy calls are deferred (urgent calls still run).
# HTCO_ETSY_DAILY_QUOTA_FLOOR=500
# Where Etsy sends the owner back after approving the connection (slice 4.3): the web app's
# callback route, registered exactly in the Etsy app. Not secret. With the credentials above, the
# vault key below and web sign-in, it turns the connect flow on.
# HTCO_ETSY_REDIRECT_URI=http://localhost:5173/integrations/etsy/callback
# Etsy token vault (slice 4.2). Seals Etsy OAuth tokens at rest; unset leaves the Etsy integration
# off. Each key is <key ID>:<32 random bytes, base64>, for example:
#   printf 'etsy-1:%s\n' "$(openssl rand -base64 32)"
# Previous keys (comma-separated) are set only while rotating: see
# docs/features/etsy-integration/token-vault.md.
# HTCO_TOKEN_VAULT_KEY=
# HTCO_TOKEN_VAULT_PREVIOUS_KEYS=
# The worker (slice 5.1, `uv run python -m htco_worker`; same HTCO_DATABASE_URL). No scheduled job
# runs unless named here (comma-separated); see docs/features/job-queue/operations.md.
# HTCO_WORKER_SCHEDULES=maintenance.purge_disconnected_shops,maintenance.prune_finished_jobs
# HTCO_WORKER_HEALTH_PORT=0
# Email (slice 6.4): `log` sends nothing; `resend` only after the owner's DNS for office.ht-co.app.
# HTCO_EMAIL_PROVIDER=log
# HTCO_RESEND_API_KEY=
# HTCO_EMAIL_REPLY_TO=support@ht-co.app
# HTCO_OFFICE_URL=https://office.ht-co.app
# Slice 7.15: the only sender whose quote mails are parsed (AutoVA's address, A-09); others are
# quarantined. Unset until the owner confirms it; the tests use quotes@autova.example.com.
# HTCO_AUTOVA_QUOTE_SENDER=
# Our receiving mail server's authserv-id: a quote mail is read only when that server's own
# Authentication-Results header reports dkim=pass for the sender's domain (From alone can be
# forged). Unset, the intake stays off; the tests use mx.quotes.example.com.
# HTCO_AUTOVA_QUOTE_AUTHSERV_ID=
# Slice 7.14 (#192): the owner's mailbox, which AutoVA writes to and which forwards the quotes. A
# quote is recorded only when AutoVA's DKIM signature covers a To naming it (no replay of
# another customer's quote); the tests use owner@shop.example.com.
# HTCO_AUTOVA_QUOTE_OWNER_MAILBOX=
# Unique per process; defaults to <host name>-<process ID>.
# HTCO_WORKER_ID=
# How long a claimed job is leased, how often an idle worker polls, and how long it drains after
# SIGTERM (code defaults).
# HTCO_WORKER_LEASE_SECONDS=60
# HTCO_WORKER_POLL_SECONDS=1.0
# HTCO_WORKER_SHUTDOWN_GRACE_SECONDS=20
# Slice 5.4: `reads` (the default) runs Etsy reads through the Action Gateway, writes refused;
# `off` refuses every action.
# HTCO_WORKER_ACTION_GATEWAY=reads
# The reviewed registry and the action contracts, relative to the working directory (the image
# copies both next to the code).
# HTCO_REGISTRY_PATH=registry
# HTCO_ACTION_SCHEMAS_PATH=packages/contracts/actions
# Slice 5.10: user triggers and admin retries of automations; keep off unless a worker runs.
# HTCO_AUTOMATIONS_ENABLED=false
# Slice 5.3: Etsy webhooks at POST /webhooks/etsy. Off by default (the route answers 404); on, it
# needs the endpoint's signing secret (whsec_...). The rate limit is per API instance.
# HTCO_ETSY_WEBHOOKS_ENABLED=false
# HTCO_ETSY_WEBHOOK_SECRET=
# HTCO_ETSY_WEBHOOK_RATE_PER_SECOND=50
# Slice 7.14: AutoVA's quote mails from Resend inbound at POST /webhooks/autova-quotes. Off (404)
# unless all three are set: Resend's webhook signing secret (whsec_...), our quote address with
# its secret token (quotes+<16 or more letters or digits>@office.ht-co.app, a secret), and the
# Etsy shop the quotes are for.
# HTCO_AUTOVA_QUOTE_WEBHOOK_SECRET=
# HTCO_AUTOVA_QUOTE_MAILBOX=
# HTCO_AUTOVA_QUOTE_ETSY_SHOP_ID=
# Verified quote-mail notices accepted per second per API instance (429 with Retry-After beyond).
# HTCO_AUTOVA_QUOTE_RATE_PER_SECOND=10
# Slice 5.4: the order history sync runs in the API process only as a fallback. On (the default
# until Etsy Order Intake is activated, slice 5.11); off, a stale read enqueues etsy.order_sync.
# HTCO_ORDER_SYNC_IN_API=true
# Slice 5.5, worker: reconciliation times (local HH:MM, the last one the full sweep) and their
# time zone; runs only when orders.reconciliation is in HTCO_WORKER_SCHEDULES.
# HTCO_RECONCILIATION_SCHEDULE=06:00,18:00
# HTCO_RECONCILIATION_TZ=Asia/Jerusalem
