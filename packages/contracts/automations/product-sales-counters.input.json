{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/automations/product-sales-counters.input.json",
  "title": "Product Sales Counters input",
  "description": "The receipt to recount and the order event that started it.",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "integer",
      "minimum": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "orders.ingested.v1",
        "orders.updated.v1",
        "orders.cancelled.v1",
        "orders.refunded.v1"
      ]
    }
  },
  "required": [
    "receipt_id"
  ],
  "additionalProperties": false
}
