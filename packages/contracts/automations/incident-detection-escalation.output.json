{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/automations/incident-detection-escalation.output.json",
  "title": "Incident Detection & Escalation output",
  "type": "object",
  "properties": {
    "checked": {"type": "integer", "minimum": 0},
    "opened": {"type": "integer", "minimum": 0},
    "resolved": {"type": "integer", "minimum": 0},
    "escalated": {"type": "integer", "minimum": 0},
    "ship_by_alerts": {"type": "integer", "minimum": 0},
    "incident_id": {"type": "string", "pattern": "^[0-9a-f-]{36}$"}
  },
  "additionalProperties": false
}
