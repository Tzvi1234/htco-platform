{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/actions/etsy.shipments.create.input.json",
  "title": "etsy.shipments.create input",
  "type": "object",
  "required": [
    "receipt_id",
    "tracking_code",
    "carrier_name"
  ],
  "properties": {
    "receipt_id": {
      "type": "integer",
      "minimum": 1
    },
    "tracking_code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9 -]+$"
    },
    "carrier_name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9-]+$"
    }
  },
  "additionalProperties": false
}
