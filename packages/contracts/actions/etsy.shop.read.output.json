{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/actions/etsy.shop.read.output.json",
  "title": "etsy.shop.read output",
  "type": "object",
  "required": [
    "shop_id",
    "name"
  ],
  "properties": {
    "shop_id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    }
  },
  "additionalProperties": false
}
