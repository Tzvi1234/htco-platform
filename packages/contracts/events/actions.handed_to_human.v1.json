{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/events/actions.handed_to_human.v1.json",
  "title": "actions.handed_to_human.v1",
  "description": "An action was handed to a person (the Human channel). Envelope: SOFTWARE_DESIGN §8.4.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "event_type": {
      "type": "string",
      "enum": [
        "actions.handed_to_human.v1"
      ]
    },
    "organization_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "shop_id": {
      "description": "string or null: the shop, when the event is about one"
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "description": "string or null"
    },
    "causation_id": {
      "description": "string or null"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "employee",
            "automation",
            "advisor",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "payload_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "action_execution_id": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "outcome": {
          "type": "string"
        },
        "error_code": {
          "description": "string or null"
        },
        "actor": {
          "type": "string"
        },
        "causation_id": {
          "description": "string or null"
        }
      },
      "required": [
        "action_execution_id",
        "action",
        "version",
        "outcome",
        "error_code",
        "actor",
        "causation_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "organization_id",
    "shop_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "actor",
    "payload_version",
    "payload"
  ],
  "additionalProperties": false
}
