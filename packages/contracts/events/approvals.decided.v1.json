{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/events/approvals.decided.v1.json",
  "title": "approvals.decided.v1",
  "description": "An approval was approved, rejected or expired (one event per decided state: an approved approval may later expire); the waiting execution resumes or ends from it, for the action it waits on only (IDs and the outcome only). Envelope: SOFTWARE_DESIGN §8.4.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "event_type": {
      "type": "string",
      "enum": [
        "approvals.decided.v1"
      ]
    },
    "organization_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "shop_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null: the shop, when the event is about one"
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "employee",
            "automation",
            "advisor",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "payload_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "action_version": {
          "type": "integer"
        },
        "waiting_execution_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "string or null"
        },
        "action_execution_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "string or null: the gateway's action execution the run waits on; the decision resumes or ends that wait only"
        },
        "decided_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "string or null"
        }
      },
      "required": [
        "approval_id",
        "state",
        "action",
        "action_version",
        "waiting_execution_id",
        "action_execution_id",
        "decided_by"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "organization_id",
    "shop_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "actor",
    "payload_version",
    "payload"
  ],
  "additionalProperties": false
}
