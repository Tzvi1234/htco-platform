{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ht-co.app/contracts/events/tasks.created.v1.json",
  "title": "tasks.created.v1",
  "description": "A task was created (kind, assignee and states only, never the title). Envelope: SOFTWARE_DESIGN §8.4.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "event_type": {
      "type": "string",
      "enum": [
        "tasks.created.v1"
      ]
    },
    "organization_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "shop_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null: the shop, when the event is about one"
    },
    "occurred_at": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "string or null"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "actor": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "user",
            "employee",
            "automation",
            "advisor",
            "system"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false
    },
    "payload_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "from_state": {
          "type": [
            "string",
            "null"
          ],
          "description": "string or null"
        },
        "to_state": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "assignee": {
          "type": "string"
        },
        "evidence_kind": {
          "type": [
            "string",
            "null"
          ],
          "description": "string or null"
        }
      },
      "required": [
        "task_id",
        "kind",
        "from_state",
        "to_state",
        "status",
        "assignee",
        "evidence_kind"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "event_id",
    "event_type",
    "organization_id",
    "shop_id",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "idempotency_key",
    "actor",
    "payload_version",
    "payload"
  ],
  "additionalProperties": false
}
